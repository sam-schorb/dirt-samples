// ---------------------------------------------------------
// LOW ARPEGGIO
// ---------------------------------------------------------

$: vch(p)
  .trans(-24)
  .arp(
    "0 5".fast(8)
  )
  .lpenv(2)
  .lpf(
    saw
      .rangex(100, 200)
      .slow(8)
  )
  .s("supersaw")
  .lpdecay(0.2)
  .detune(0.6)
  .o(3)




// ---------------------------------------------------------
// RHYTHMIC CHORD PATTERN
// ---------------------------------------------------------

$: vch(p)
  .trans(-24)
  .beat(
    "0, 3, 6".fast(16),
    8
  )
  .lpenv(2)
  .lpf(
    saw
      .rangex(600, 2000)
      .slow(8)
  )
  .s("supersaw")
  .lpdecay(0.2)
  .detune(0.6)
  .hpf(600)
  .o(3)




// ---------------------------------------------------------
// KICK + SIDECHAIN
// ---------------------------------------------------------

$: s("bd:4*4")
  .duck(0.4)