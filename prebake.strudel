// ---------------------------------------------------------
// SAMPLES & TEMPO
// ---------------------------------------------------------
samples('github:sam-schorb/dirt-samples')

samples('github:bubobubobubobubo/dough-waveforms')

// ---------------------------------------------------------
// SETUP
// ---------------------------------------------------------


setcps(135 / 60 / 4)

const KEY = 'A:minor'


// ---------------------------------------------------------
// ACCENT CHAINS
// usage: pat.acc1(), pat.acc2(), pat.acc3()
// ---------------------------------------------------------
register('acc1', pat =>
  pat.mul(gain("[1 0.75 0.75 1 0.75 0.75 1 0.75]*2"))
)

register('acc2', pat =>
  pat.mul(gain("[1 0.75 0.5 0.75 1 0.75 0.5 0.75]*2"))
)

register('acc3', pat =>
  pat.mul(gain("[1 0.5]*8"))
)


// ---------------------------------------------------------
// FILLS
// usage: pat.fill1(), pat.fill2()
// ---------------------------------------------------------
register('fill1', (n, pat) =>
  pat.every(n, off(1/8, x => x.add(0).hpf(200)))
)

register('fill2', (n, pat) =>
  pat.every(n, off(1/8, x =>
    x.contract("2 4").pace(1).mask("1 0 1 0 1 0 1 0")
  )).hpf(200)
)


// ---------------------------------------------------------
// HYPNO FX
// usage: pat.hypno1(6), pat.hypno2(6)
// ---------------------------------------------------------

register('hypno1', (vol, n, pat) =>
  pat.gain(1).superimpose(x =>
    x.delay("1:0.33:0.5")
     .mul(gain(vol / 2))
     .hpf(400)
     .orbit(n)
  ).orbit(n)
)


register('hypno2', (vol, n, pat) =>
  pat.gain(1).superimpose(x =>
    x.delay("1:0.33:0.5")
     .pan("1 0 1 0")
     .accelerate(perlin.range(1, 3).slow(7))
     .mul(gain(vol / 2))
     .hpf(sine.range(400, 2000).slow(6))
     .hpf(sine.range(600, 8000).slow(8))
     .orbit(n)
  ).orbit(n)
)





// ---------------------------------------------------------
// FLANGE (amount-controlled feedback)
// usage:
//   s("ch*4").flange(rate)           // amount defaults to 1
//   s("ch*4").flange(rate, amount)   // amount 0..1 maps fb 0.89..0.99
// ---------------------------------------------------------
register('flange', (amount, rate, pat) =>
  pat.superimpose(x =>
    x.delay(0.2)
     .delayt(sine.range(0.002, 0.008).slow(rate))
     .delayfb(0.79 + (0.20 * (amount !== undefined ? amount : 1)))
  )
)

// ---------------------------------------------------------
// PHASOR (amount, rateInCycles)
// amount: 0..1 (depth)
// rateInCycles: higher = slower (inverted mapping)
// fixed: center=1000, sweep=2000
//
// usage:
//   pat.phasor()            // amount=0.75, rate=1
//   pat.phasor(0.6)         // amount=0.6, rate=1
//   pat.phasor(0.6, 32)     // slower than rate=1
// ---------------------------------------------------------
register('phasor', (amount, rate, pat) =>
  (pat === undefined
    ? amount
        .phaser(1)
        .phaserdepth(0.75)
        .phasercenter(1000)
        .phasersweep(2000)
    : pat
        .phaser(1 / (rate !== undefined ? rate : 1))
        .phaserdepth(amount !== undefined ? amount : 0.75)
        .phasercenter(1000)
        .phasersweep(2000)
  )
)





// ---------------------------------------------------------
// SWING
// usage: pat.swang()
// ---------------------------------------------------------
register('swang', pat =>
  pat.swingBy(1/8, 8)
)


// ---------------------------------------------------------
// MUTES: CTRL+1..9 => "ctrl1" .. "ctrl9"
// usage: pat.mute('ctrl1')
// ---------------------------------------------------------
// global toggle state
const keystatus = {};

// Ctrl+1..9 toggle (no auto-repeat)
window.addEventListener('keydown', (e) => {
  if (e.repeat) return;

  if (e.ctrlKey && e.key >= '1' && e.key <= '9') {
    const id = 'ctrl' + e.key;      // "ctrl1", "ctrl2", ...
    keystatus[id] = !(keystatus[id] ?? false);
  }
});

// 0/1 pattern driven by keystatus[key]
register('mykeys', (key, pat) =>
  pat.withValue(() => (keystatus[key] ? 0 : 1))
);

// convenience: pat.mute("ctrl1") == pat.mask("1".mykeys("ctrl1"))
register('mute', (key, pat) =>
  pat.mask("1".mykeys(key))
);



// ---------------------------------------------------------
// ACID FILTER CHAIN
// usage: pat.acidfilt(4)
// ---------------------------------------------------------
register('acidfilt', (x, pat) =>
  pat.wt(perlin.range(0, 1).slow(3.9))
     .lpf(sine.range(200, 1600).slow(16))
     .lpd(perlin.range(0.1, 0.4))
     .lpq(sine.range(6, 13).slow(32))
     .lpenv(x)
     .ftype('12db')
)


// INCIDENTALS PATTERN
// usage in REPL: $: incidentals
window.incidentals =
  note("0 ~ 12 7  ~ ~ 0 ~  12 7 ~ 0  ~ ~ 12 ~")
    .n("<0 4 5>")
    .legato(6)
    .accelerate("<1 2 3>")
    .hpf(300)
    .lpf(2000)
    .orbit(6)
    .mul(gain(0.6))
    .jux(rev)
    .superimpose(x =>
      x.delay("1:.3:.9")
       .mul(gain(0.9))
       .hpf(400)
       .room(0.9)
       .size(0.5)
       .orbit(6)
    )
    .sometimes(x => x.ply(2))
    .iter(4)
    .shuffle(8)


// ---------------------------------------------------------
// KEY
// ---------------------------------------------------------

// Strictly diatonic:
// const CHORD_OVERRIDES = {}

// These give D major and E major in A minor,
// matching: Am C D F Am E Am E

const CHORD_OVERRIDES = {
  4: 'maj',
  5: 'maj',
}


// ---------------------------------------------------------
// KEY BUILDER
// ---------------------------------------------------------

const NOTE_NAMES = [
  'C',
  'C#',
  'D',
  'D#',
  'E',
  'F',
  'F#',
  'G',
  'G#',
  'A',
  'A#',
  'B',
]

const NOTE_INDEX = {
  C: 0,
  'C#': 1,
  Db: 1,
  D: 2,
  'D#': 3,
  Eb: 3,
  E: 4,
  F: 5,
  'F#': 6,
  Gb: 6,
  G: 7,
  'G#': 8,
  Ab: 8,
  A: 9,
  'A#': 10,
  Bb: 10,
  B: 11,
}

const MODES = {
  major: {
    steps: [
      0, 2, 4, 5, 7, 9, 11,
    ],

    qualities: [
      'maj',
      'min',
      'min',
      'maj',
      'maj',
      'min',
      'dim',
    ],
  },

  minor: {
    steps: [
      0, 2, 3, 5, 7, 8, 10,
    ],

    qualities: [
      'min',
      'dim',
      'maj',
      'min',
      'min',
      'maj',
      'maj',
    ],
  },

  dorian: {
    steps: [
      0, 2, 3, 5, 7, 9, 10,
    ],

    qualities: [
      'min',
      'min',
      'maj',
      'maj',
      'min',
      'dim',
      'maj',
    ],
  },

  phrygian: {
    steps: [
      0, 1, 3, 5, 7, 8, 10,
    ],

    qualities: [
      'min',
      'maj',
      'maj',
      'min',
      'dim',
      'maj',
      'min',
    ],
  },

  harmonicMinor: {
    steps: [
      0, 2, 3, 5, 7, 8, 11,
    ],

    qualities: [
      'min',
      'dim',
      'aug',
      'min',
      'maj',
      'maj',
      'dim',
    ],
  },
}

const QUALITY_SUFFIX = {
  maj: '',
  major: '',

  min: 'm',
  minor: 'm',

  dim: 'o',
  diminished: 'o',

  aug: 'aug',
  augmented: 'aug',
}

const makeKey = (
  keyName,
  alterations = {}
) => {
  const [
    tonic,
    modeName = 'minor',
  ] = keyName.split(':')

  const tonicIndex = NOTE_INDEX[tonic]
  const mode = MODES[modeName]

  if (tonicIndex === undefined) {
    throw new Error(
      'Unknown key tonic: ' + tonic
    )
  }

  if (!mode) {
    throw new Error(
      'Unknown mode: ' + modeName
    )
  }

  return Object.fromEntries(
    mode.steps.map((step, index) => {
      const degree = index + 1

      const quality =
        Object.prototype.hasOwnProperty.call(
          alterations,
          degree
        )
          ? alterations[degree]
          : mode.qualities[index]

      const suffix =
        Object.prototype.hasOwnProperty.call(
          QUALITY_SUFFIX,
          quality
        )
          ? QUALITY_SUFFIX[quality]
          : quality

      const root =
        NOTE_NAMES[
          (tonicIndex + step) % 12
        ]

      return [
        degree,
        root + suffix,
      ]
    })
  )
}

const KEY_CHORDS = makeKey(
  KEY,
  CHORD_OVERRIDES
)


// ---------------------------------------------------------
// CUSTOM FUNCTIONS
// ---------------------------------------------------------

// Numeric progression -> chord symbols -> voicing

const vch = register(
  'vch',
  pat =>
    pat
      .pick(KEY_CHORDS)
      .voicing()
)


// .duck(0.4)

register(
  'duck',
  (amount, pat) =>
    pat
      .duckorbit("2:3:4:5")
      .duckdepth(amount)
)


// .verb(0.8)

register(
  'verb',
  (amount, pat) =>
    pat
      .room(amount)
      .sz(amount)
)


// .space(slider(0, 0, 0.7))

register(
  'space',
  (wet, pat) =>
    pat.superimpose(
      x =>
        x
          .delay(1)
          .delayfb(0.6)
          .gain(wet)
    )
)


// =========================================================
// LIVE CODE
// =========================================================

// 1 = tonic
// 2 = second chord
// 3 = third chord
// 4 = fourth chord
// 5 = fifth chord
// 6 = sixth chord
// 7 = seventh chord

// ---------------------------------------------------------
// CANONICAL PATTERN DATA (no note(), no n())
// everything is just strings
// ---------------------------------------------------------

// MELODIES (now just data)
window.mel1  = "0 ~ ~ 1  ~ 6 0 ~  ~ ~ ~ 1  3 7 ~ ~"
window.mel2  = "1 ~ 0 3  ~ 7 ~ ~  7 ~ ~ 7  ~ ~ ~ ~"
window.mel3  = "1 ~ 6 5  ~ 0 ~ 0  ~ 1 13 ~  ~ ~ ~ ~"
window.mel4  = "~ ~ ~ 1  0 8 ~ ~  ~ 13 5 ~  0 6 ~ ~"
window.mel5  = "~ ~ 0 1  ~ ~ 6 ~  ~ 1 3 ~  2 5  ~ ~"
window.mel6  = "6 ~ ~ -5  ~ ~ 6 ~  ~ -5 5 ~  ~ 1 ~ ~  6 ~ ~ -5  ~ ~ 6 ~  ~ -5 13 ~  ~ 1 ~ ~".slow(2)
window.mel7  = "6 0 ~ ~  ~ ~ 6 ~  ~ 0 ~ ~  6 ~ ~ ~  0 ~ 6 ~  ~ ~ ~ ~  0 ~ ~ 6  ~ ~ 0 ~".slow(2)
window.mel8  = "0 ~ 1 7  ~ ~ 6 ~  0 1 ~ 7  ~ ~ 6 ~"
window.mel9  = "13 ~ ~ 1  ~ 7 ~ 6".fast(2)
window.mel10 = "0 13 ~ 1  ~ ~ ~ ~".fast(2)
window.mel11 = "0 ~ ~ ~  3 ~ ~ 7  ~ 3 -5 ~  0 ~ ~ ~"
window.mel12 = "0"

// POLYMELODIES
window.polymel1  = "{0 ~ ~ 1  ~ 6 0 ~  ~ ~ ~ 1  3 7}%16"
window.polymel2  = "{1 ~ 0 3  ~ 7 ~ ~  7 ~ ~ 7  ~ ~}%16"
window.polymel3  = "{1 ~ 6 5  ~ 0 ~ 0  ~ 1 13 ~}%16"
window.polymel4  = "{~ ~ ~ 1  0 8 ~ ~  ~ 13}%16"
window.polymel5  = "{~ ~ 0 1  ~ ~ 6 ~  ~ 1 3 ~}%16"
window.polymel6  = "{6 ~ ~ -5  ~ ~ 6 ~  ~ -5 5 ~  ~ 1 ~ ~  6 ~ ~ -5  ~ ~ 6 ~  ~ -5 13 ~}%32".slow(2)
window.polymel7  = "{6 0 ~ ~  ~ ~ 6 ~  ~ 0 ~ ~  6 ~ ~ ~  0 ~ 6 ~  ~ ~ ~ ~}%32".slow(2)
window.polymel8  = "{0 ~ 1 7  ~ ~ 6 ~  0 1 ~ 7  ~ ~}%16"
window.polymel9  = "{13 ~ ~ 1  ~ 7}%8".fast(2)
window.polymel10 = "{0 13 ~ 1  ~ ~}%8".fast(2)
window.polymel11 = "{0 ~ ~ ~  3 ~ ~ 7  ~ 3 -5 ~  0 ~}%16"
window.polymel12 = "0"


// ---------------------------------------------------------
// INTERPRETERS
// ---------------------------------------------------------

// 🎹 melodic (scale + octave)
const mel = str =>
  note(str)
    .scale("minor")
    .add(note(-12))

// 🥁 sample selector (index pattern)
const pat = str =>
  n(str)

// 🔳 binary mask (on/off from pattern)
const bin = str =>
  n(str).set(n(0))




// ---------------------------------------------------------
// USAGE EXAMPLES
// ---------------------------------------------------------



// $: mel(polymel3).s("wt_10")

// $: mel(polymel3).s("bdsyn").hypno1(0.5,0.5).fill1(4)

// $: sound("bdd:3*4").gain(3)

// $: bin(mel1).s("cp").mask("1 0 0 0".slow(4))

// $: mel(polymel4).s("lead:2").slow(8).off(0.125, x => x.note(add(7))).every(2, jux(rev)).superimpose(x => x.fast(2)).speed(0.5).gain(0.5).chunk(4, hurry(2))


// ---------------------------------------------------------
// HIGH ARPEGGIO
// ---------------------------------------------------------

let p = "<1 3 6 5 1 7 2 4>"


// $: vch(p)
//   .trans(-12)
